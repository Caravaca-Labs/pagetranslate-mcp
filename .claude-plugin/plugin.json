{
  "name": "pagetranslate",
  "displayName": "PageTranslate",
  "version": "0.1.3",
  "description": "PDF translator and document translator for Claude: translate PDF, scanned PDF, DOCX, EPUB and image files into 70+ languages and get the same kind of file back, layout kept.",
  "author": { "name": "PageTranslate", "url": "https://pagetranslate.ai" },
  "homepage": "https://pagetranslate.ai",
  "repository": "https://github.com/Caravaca-Labs/pagetranslate-mcp",
  "license": "MIT",
  "keywords": ["translation", "pdf-translator", "document-translation", "docx", "epub", "ocr", "mcp"],
  "userConfig": {
    "api_key": {
      "type": "string",
      "title": "PageTranslate API key",
      "description": "Create one at https://pagetranslate.ai/dashboard/api-keys",
      "sensitive": true,
      "required": true
    }
  },
  "mcpServers": {
    "pagetranslate": {
      "command": "npx",
      "args": ["-y", "pagetranslate-mcp@0.1.3"],
      "env": { "CLAUDE_PLUGIN_OPTION_API_KEY": "${user_config.api_key}" }
    }
  }
}
