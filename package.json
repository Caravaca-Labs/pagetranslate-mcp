{
  "name": "pagetranslate-mcp",
  "version": "0.1.1",
  "description": "PDF translator and document translator for AI agents: an MCP server and agent skills that translate PDF, scanned PDF, DOCX, EPUB and image files into 70+ languages, layout kept.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "translation",
    "document-translation",
    "pdf-translator",
    "docx",
    "epub",
    "book-translation",
    "ocr",
    "agent-skills",
    "pi-package",
    "translate-pdf",
    "epub-translator",
    "document-translator"
  ],
  "homepage": "https://pagetranslate.ai",
  "bugs": "https://github.com/Caravaca-Labs/pagetranslate-mcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Caravaca-Labs/pagetranslate-mcp.git"
  },
  "license": "MIT",
  "author": "PageTranslate (https://pagetranslate.ai)",
  "mcpName": "io.github.catorch/pagetranslate-mcp",
  "type": "module",
  "bin": {
    "pagetranslate-mcp": "index.js"
  },
  "files": [
    "index.js",
    "skills",
    "server.json",
    "npm-shrinkwrap.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/e2e.mjs",
    "version": "node scripts/sync-version.mjs && node scripts/build-skills.mjs && git add server.json .claude-plugin/plugin.json .cursor-plugin/plugin.json gemini-extension.json skills",
    "build:skills": "node scripts/build-skills.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  }
}
